# Production should use PostgreSQL. SQLite is only the local fallback.
DATABASE_URL=postgresql+psycopg://jas_user:replace_me@localhost:5432/jas
PUBLIC_BASE_URL=http://localhost:8501

# Used once to bootstrap the first account. Remove ADMIN_PASSWORD afterward.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=System Administrator

PRIVATE_UPLOAD_DIR=./private_uploads
DOCUMENT_OUTPUT_DIR=./generated_documents
TEMPLATE_STORAGE_DIR=./private_uploads/templates
# auto = Microsoft Word first on Windows, LibreOffice elsewhere/fallback.
# Production containers use libreoffice. Use none only to deliberately disable PDF output.
DOCX_PDF_CONVERTER=auto
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
MAX_UPLOAD_BYTES=5242880
SESSION_HOURS=8
