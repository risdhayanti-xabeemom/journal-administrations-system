# Production should use PostgreSQL. SQLite is only the local fallback.
DATABASE_URL=postgresql+psycopg://jas_user:replace_me@localhost:5432/jas
# Production example: https://jasv1-journal.streamlit.app (no query or fragment).
# Local development may use http://localhost:8501.
PUBLIC_BASE_URL=http://localhost:8501

# Used once to bootstrap the first account. Remove ADMIN_PASSWORD afterward.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-with-at-least-12-characters
ADMIN_NAME=System Administrator

PRIVATE_UPLOAD_DIR=./private_uploads
DOCUMENT_OUTPUT_DIR=./generated_documents
TEMPLATE_STORAGE_DIR=./private_uploads/templates
# auto = Microsoft Word first on Windows, LibreOffice elsewhere/fallback.
# Production containers use libreoffice. Use none only to deliberately disable PDF output.
DOCX_PDF_CONVERTER=auto
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
MAX_UPLOAD_BYTES=5242880
SESSION_HOURS=8

# Quick Article Revision: disabled AI and private local storage by default.
# On Streamlit Cloud use a persistent PRIVATE Supabase Storage bucket.
REVISION_STORAGE_BACKEND=local
REVISION_STORAGE_DIR=./private_uploads/revisions
# REVISION_STORAGE_BACKEND=supabase
# REVISION_SUPABASE_URL=https://your-project.supabase.co
# REVISION_SUPABASE_SERVICE_ROLE_KEY=keep-in-Streamlit-Secrets-only
REVISION_SUPABASE_BUCKET=jas-private-revisions
REVISION_MAX_FILE_BYTES=20971520
REVISION_DEFAULT_MODE=REVIEWER_DRIVEN
REVISION_HIGHLIGHT_STYLE=yellow
REVISION_ALLOW_FULL_POLISHING=false
REVISION_AI_ENABLED=false
REVISION_AI_PROVIDER=openai_compatible
# REVISION_AI_ENDPOINT=https://your-private-compatible-endpoint/v1/chat/completions
# REVISION_AI_MODEL=your-approved-model
# REVISION_AI_API_KEY=keep-in-Streamlit-Secrets-only
